# The network the indexer follows and the interface reads.
RATIFY_RPC_URL=https://soroban-testnet.stellar.org
RATIFY_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The factory whose register defines which communities exist. Every other
# address the indexer follows is discovered from it.
RATIFY_FACTORY_ID=

# Where the index lives. Both the indexer and the web app read this.
RATIFY_DB_PATH=./data/ratify.db

# How often the indexer asks for new events, in milliseconds.
RATIFY_POLL_MS=5000
